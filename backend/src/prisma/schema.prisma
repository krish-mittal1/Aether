generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String       @id @default(uuid())
  username  String       @unique
  email     String       @unique
  password  String
  avatar    String?
  createdAt DateTime     @default(now())
  rooms     Room[]       @relation("RoomOwner")
  members   RoomMember[]
  messages  Message[]
}

model Room {
  id        String       @id @default(uuid())
  name      String
  ownerId   String
  createdAt DateTime     @default(now())
  owner     User         @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   RoomMember[]
  files     File[]
  messages  Message[]
}

model RoomMember {
  id        String   @id @default(uuid())
  userId    String
  roomId    String
  role      String   @default("member")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
}

model File {
  id        String   @id @default(uuid())
  roomId    String
  parentId  String?
  name      String
  type      String
  content   String   @default("")
  language  String   @default("javascript")
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  parent    File?    @relation("FileTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  File[]   @relation("FileTree")
  versions  FileVersion[]

  @@unique([roomId, parentId, name])
}

model FileVersion {
  id        String   @id @default(uuid())
  fileId    String
  userId    String?
  version   Int
  content   String
  createdAt DateTime @default(now())
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, version])
  @@index([fileId, createdAt])
}

model Message {
  id        String   @id @default(uuid())
  roomId    String
  senderId  String
  content   String
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
}
