POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=collab
DATABASE_URL=postgresql://postgres:replace-with-strong-postgres-password@postgres:5432/collab
REDIS_URL=redis://redis:6379/0
# IMPORTANT: Replace with a long random secret before deploying!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000
EXECUTION_TIMEOUT_SECONDS=5
CORS_ORIGINS=http://localhost:3000
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Production/VPS example:
# API_DOMAIN=api.aether.codexarena.app
# ACME_EMAIL=admin@codexarena.app
# NEXT_PUBLIC_API_URL=https://api.aether.codexarena.app/api
